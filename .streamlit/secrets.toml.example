# Скопируй в .streamlit/secrets.toml и впиши реальные значения.
# secrets.toml в .gitignore — не коммитить.
TELEGRAM_BOT_TOKEN = ""

[smtp]
host      = "smtp.gmail.com"
port      = 587
user      = "alerts@example.com"
password  = ""
from_addr = "GoldenMatch <alerts@example.com>"
starttls  = true

[gigachat]
credentials = ""  # Base64(client_id:client_secret) из личного кабинета developers.sber.ru
scope       = "GIGACHAT_API_B2B"
ca_bundle   = ""  # путь к сертификату Минцифры (пусто = системное хранилище)
